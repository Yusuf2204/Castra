# ============================================================
# React CMS — Docker Environment Variables (Template)
# ============================================================
# Copy this file to .env and adjust values for your environment.
# The .env file is read by docker-compose.yml.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME="Castra"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_KEY=

# ── Ports (host:container) ───────────────────────────────────
NGINX_PORT=80
BACKEND_PORT=9001
FRONTEND_PORT=9002

# ── Database (internal db service) ───────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=castra
DB_USERNAME=castra
DB_PASSWORD=your_db_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# ── Session ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ── Sanctum ──────────────────────────────────────────────────
SANCTUM_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=castra_

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:9001,http://localhost:9002
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Requested-With
CORS_MAX_AGE=600
CORS_SUPPORTS_CREDENTIALS=false

# ── Admin Account (seeded on first boot) ─────────────────────
# min 12 characters — change before any real deployment
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password_123

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ── Cache / Queue ────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ── Swagger ──────────────────────────────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true
