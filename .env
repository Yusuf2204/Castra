# ============================================================
# React CMS — Docker Environment Variables
# ============================================================
# Copy this file to .env and adjust values for your environment.
# The .env file is read by docker-compose.yml.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME="Castra"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_KEY=base64:o0BSUdj2EBXq5ZQcZMpzUG9wAPFwTVtTARy2EiNGp8Q=

# ── Ports (host:container) ───────────────────────────────────
NGINX_PORT=80
BACKEND_PORT=9001
FRONTEND_PORT=9002

# ── Database (internal db service) ───────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=castra
DB_USERNAME=castra
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

# ── Session ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# false: stack is served over plain HTTP on localhost
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ── Sanctum ──────────────────────────────────────────────────
SANCTUM_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=castra_

# ── CORS ─────────────────────────────────────────────────────
# direct-port access (Swagger on :9001, frontend on :9002).
# Access via the reverse proxy (:80) is same-origin and needs no CORS.
CORS_ALLOWED_ORIGINS=http://localhost:9001,http://localhost:9002
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Requested-With
CORS_MAX_AGE=600
CORS_SUPPORTS_CREDENTIALS=false

# ── Admin Account (seeded on first boot) ─────────────────────
# min 12 characters — change before any real deployment
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword123

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ── Cache / Queue ────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ── Swagger ──────────────────────────────────────────────────
# Docs are generated at image build and on container start when
# missing. Set to true during heavy annotation editing to regenerate
# on every request (slower, but no rebuild needed).
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true
